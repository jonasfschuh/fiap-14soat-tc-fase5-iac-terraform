# Variáveis Obrigatórias
bucket_name = "coloque-seu-bucket-aqui"
eks_cluster_name = "eks-cluster-fiap-14soat-fase4"

# Variáveis para IAM/EKS no AWS Academy
eks_cluster_role_name = "LabRole"
eks_node_role_name    = "LabRole"

# Variáveis para API Gateway e Lambda
lambda_terraform_state_bucket = "fiap-14soat-terraform-state"
lambda_terraform_state_key    = "lambda-auth/terraform.tfstate"
jwt_issuer                    = "RaceforceApi"
jwt_audience                  = "AuthorizedServices"

